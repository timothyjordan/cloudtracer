  "cdn": {
    "cloudflare": {
      "headers": { "CF-Ray": "*", "Server": "cloudflare", "CF-Cache-Status": "*" },
      "cnames": ["*.cloudflare.net", "*.cloudflaressl.com"]
    },
    "fastly": {
      "headers": { "X-Served-By": "cache-*", "Via": "*Fastly*", "X-Fastly-Request-ID": "*" },
      "cnames": ["*.fastly.net", "*.fastlylb.net"]
    },
    "akamai": {
      "headers": { "X-Akamai-Transformed": "*", "Server": "AkamaiGHost" },
      "cnames": ["*.akamaiedge.net", "*.akamai.net", "*.akamaitechnologies.com", "*.edgekey.net"]
    },
    "cloudfront": {
      "headers": { "X-Amz-Cf-Id": "*", "X-Amz-Cf-Pop": "*", "Via": "*CloudFront*" },
      "cnames": ["*.cloudfront.net"]
    },
    "bunnycdn": {
      "headers": { "Server": "BunnyCDN*", "CDN-PullZone": "*", "CDN-Uid": "*" },
      "cnames": ["*.b-cdn.net"]
    },
    "keycdn": {
      "headers": { "Server": "keycdn*", "X-Edge-Location": "*" },
      "cnames": ["*.kxcdn.com"]
    },
    "stackpath": {
      "headers": { "X-HW": "*" },
      "cnames": ["*.stackpathdns.com", "*.hwcdn.net"]
    },
    "sucuri": {
      "headers": { "Server": "Sucuri*", "X-Sucuri-ID": "*" },
      "cnames": ["*.sucuri.net"]
    },
    "incapsula": {
      "headers": { "X-CDN": "Imperva", "X-Iinfo": "*" },
      "cnames": ["*.incapdns.net"]
    },
    "vercel": {
      "headers": { "Server": "Vercel", "X-Vercel-Id": "*", "X-Vercel-Cache": "*" },
      "cnames": ["*.vercel-dns.com", "cname.vercel-dns.com"]
    },
    "netlify": {
      "headers": { "Server": "Netlify", "X-NF-Request-ID": "*" },
      "cnames": ["*.netlify.app", "*.netlify.com"]
    }
  },
