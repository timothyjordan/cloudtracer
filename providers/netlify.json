{
  "id": "netlify",
  "name": "Netlify",
  "priority": 92,
  "verification_domains": [
    "netlify.com"
  ],
  "cdn": {
    "headers": {
      "Server": "Netlify",
      "X-NF-Request-ID": "*"
    },
    "cnames": [
      "*.netlify.app",
      "*.netlify.com"
    ],
    "is_platform": true
  },
  "platform_rules": [
    {
      "dns_from": "NS1"
    }
  ]
}
