{
  "manifest_version": 3,
  "name": "CloudTracer",
  "version": "0.1.0",
  "description": "See the cloud providers behind any website — DNS, CDN, hosting, SSL, email and more — for the tab you're on.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CloudTracer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["<all_urls>"]
}
