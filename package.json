{
  "name": "cloudtracer",
  "version": "0.1.0",
  "description": "Scan a website and identify all cloud providers it uses",
  "type": "module",
  "bin": {
    "cloudtracer": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "build:ext": "tsc --noEmit -p extension/tsconfig.json && node extension/build.mjs",
    "package:ext": "node scripts/package-extension.mjs --rebuild",
    "dev:ext": "node extension/build.mjs --watch",
    "lint": "eslint src/ extension/src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "website",
    "scanner",
    "cloud",
    "infrastructure",
    "dns",
    "cdn",
    "hosting",
    "ssl",
    "whois",
    "rdap"
  ],
  "author": "Timothy Jordan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothyjordan/cloudtracer.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/adm-zip": "^0.5.8",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "ipaddr.js": "^2.3.0",
    "prompts": "^2.4.2",
    "whoiser": "^2.0.0-beta.10",
    "yaml": "^2.8.3"
  }
}
